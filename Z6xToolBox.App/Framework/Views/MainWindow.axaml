<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Z6xToolBox.App.Framework.ViewModels"
        xmlns:models="using:Z6xToolBox.App.Framework.Models"
        x:Class="Z6xToolBox.App.Framework.Views.MainWindow"
        Title="Z6xToolBox - 极米 Z6X Pro 工具箱"
        Width="1240" Height="840"
        MinWidth="960" MinHeight="600"
        Background="#12151c">

    <Grid ColumnDefinitions="300,*">

        <!-- 左侧单列可折叠导航栏 -->
        <Border Grid.Column="0"
                Background="#0e1017"
                BorderBrush="#212530"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,14">
                <!-- 底部关于信息 -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="Z6xToolBox v0.1.0 · Steam Deck"
                           FontSize="11"
                           Foreground="#4b5563"
                           Margin="8,8,0,0" />

                <!-- 可折叠分组模块列表 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <!-- 分组 Header -->
                                    <Button Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Tag="{Binding}"
                                            Click="OnGroupHeaderClick">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#161922" />
                                            </Style>
                                        </Button.Styles>
                                        <Grid ColumnDefinitions="16,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ArrowIcon}"
                                                       FontSize="9"
                                                       Foreground="#6b7280"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#8b949e"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <!-- 子项列表 -->
                                    <ListBox ItemsSource="{Binding Items}"
                                             SelectedItem="{Binding $parent[Window].DataContext.SelectedModule, Mode=OneWay}"
                                             SelectionChanged="OnListBoxSelectionChanged"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="8,2,0,0"
                                             IsVisible="{Binding IsExpanded}">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="10,6" />
                                                <Setter Property="CornerRadius" Value="4" />
                                                <Setter Property="Margin" Value="0,1" />
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#181c28" />
                                            </Style>
                                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#232938" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="12"
                                                           Foreground="#d1d5db"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 右侧内容详情正文区 -->
        <Grid Grid.Column="1" Margin="32,20,36,20">
            <!-- 复制成功浮层提示 -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#1f2430"
                    BorderBrush="#3b4252"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,6"
                    ZIndex="10"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#38bdf8" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Left">

                    <!-- 文章主标题 -->
                    <TextBlock Text="{Binding SelectedModule.Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#f9fafb" />

                    <!-- 文章简要概括 -->
                    <TextBlock Text="{Binding SelectedModule.Summary}"
                               FontSize="13"
                               Foreground="#9ca3af"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               IsVisible="{Binding SelectedModule.Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- 分隔线 -->
                    <Rectangle Height="1" Fill="#212530" Margin="0,4,0,8" />

                    <!-- 各章节自然流式段落 -->
                    <ItemsControl ItemsSource="{Binding SelectedModule.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="10" Margin="0,0,0,22">

                                    <!-- 小节标题 -->
                                    <TextBlock Text="{Binding Heading}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#e5e7eb"
                                               IsVisible="{Binding Heading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <!-- 正文说明文本 -->
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="13"
                                               Foreground="#d1d5db"
                                               TextWrapping="Wrap"
                                               LineHeight="22"
                                               IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <!-- 要点列表 -->
                                    <ItemsControl ItemsSource="{Binding BulletPoints}"
                                                  IsVisible="{Binding BulletPoints.Count}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" Text="• " FontSize="13" Foreground="#60a5fa" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" Foreground="#9ca3af" TextWrapping="Wrap" LineHeight="20" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 代码块与回显 -->
                                    <ItemsControl ItemsSource="{Binding CodeBlocks}"
                                                  IsVisible="{Binding CodeBlocks.Count}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#161922"
                                                        BorderBrush="#252936"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Margin="0,4,0,10">
                                                    <StackPanel>
                                                        <!-- 工具条 -->
                                                        <Border Background="#1a1e28"
                                                                BorderBrush="#252936"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="10,6"
                                                                CornerRadius="6,6,0,0">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           FontSize="12"
                                                                           FontWeight="Medium"
                                                                           Foreground="#93c5fd"
                                                                           VerticalAlignment="Center" />
                                                                <Button Grid.Column="1"
                                                                        Content="复制命令"
                                                                        FontSize="11"
                                                                        Padding="8,2"
                                                                        Tag="{Binding Code}"
                                                                        Click="OnCopyButtonClick" />
                                                            </Grid>
                                                        </Border>

                                                        <!-- 执行命令文本 -->
                                                        <Border Padding="12,10" Background="#13161f">
                                                            <SelectableTextBlock Text="{Binding Code}"
                                                                                 FontFamily="Consolas,Monospace"
                                                                                 FontSize="12"
                                                                                 Foreground="#f3f4f6"
                                                                                 TextWrapping="Wrap"
                                                                                 LineHeight="19" />
                                                        </Border>

                                                        <!-- 预期返回与行内解析 -->
                                                        <Border Background="#0d1017"
                                                                BorderBrush="#202430"
                                                                BorderThickness="0,1,0,0"
                                                                Padding="12,10"
                                                                IsVisible="{Binding ExpectedOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="返回输出与行内解析:" FontSize="10" Foreground="#6b7280" />
                                                                <SelectableTextBlock Text="{Binding ExpectedOutput}"
                                                                                     FontFamily="Consolas,Monospace"
                                                                                     FontSize="11"
                                                                                     Foreground="#86efac"
                                                                                     TextWrapping="Wrap"
                                                                                     LineHeight="18" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- 附注说明 -->
                                                        <Border Padding="12,6"
                                                                Background="#161922"
                                                                BorderBrush="#202430"
                                                                BorderThickness="0,1,0,0"
                                                                IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding Note, StringFormat='注: {0}'}"
                                                                       FontSize="11"
                                                                       Foreground="#9ca3af"
                                                                       TextWrapping="Wrap" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
